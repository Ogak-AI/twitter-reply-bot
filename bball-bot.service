[Unit]
Description=Basketball News Buffer Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/bball-buffer-bot
EnvironmentFile=/opt/bball-buffer-bot/.env
ExecStart=/opt/bball-buffer-bot/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bball-bot

# Auto-restart on failure, but not more than 5 times in 60 seconds
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
