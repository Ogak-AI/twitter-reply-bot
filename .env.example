# ─────────────────────────────────────────────────
# .env.example — World Cup 2026 Reply Bot
# Copy to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────

# Buffer API (required)
BUFFER_API_KEY=your_buffer_api_key_here
BUFFER_CHANNEL_ID=your_x_channel_id_here
BUFFER_MODE=shareNow

# AI Provider — Groq only
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Logging
LOG_LEVEL=INFO
